# Copy to docker/.env (gitignored) and fill in every value marked change-me, or run: make env
# Compose reads docker/.env automatically. Never commit the real .env.

# Docker Hub namespace for the app images (pushed by make docker-push)
DOCKERHUB_USER=your-dockerhub-username
API_TAG=1.0.0
FRONTEND_TAG=1.0.0

# Host port for the gateway (the brief requires 80)
NGINX_PORT=80

# MongoDB root account (the API connects with it, auth source admin)
MONGO_ROOT_USER=projecthub
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=projecthub

# Valkey cache password (required)
VALKEY_PASSWORD=change-me

# JWT signing secret: at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_EXPIRES_IN=24h

# Create the test accounts and sample project on first start (exam needs them)
SEED_ENABLED=true
