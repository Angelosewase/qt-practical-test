# Build context is the repository root. Deny everything by default, then allow only what the images need.
# This also keeps .private/, secrets.env, .git, state files and scratch space out of every build.
*
!app/backend
!app/frontend
!docker/frontend-nginx.conf

# Local secrets and environment files (only the .env.example templates may enter the context)
**/.env
**/.env.*
!**/.env.example

# Build outputs and dependencies are rebuilt inside the image
**/node_modules
**/dist
backend/bin
**/*.log
